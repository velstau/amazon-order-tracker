{
  "manifest_version": 3,
  "name": "Amazon Order Tracker",
  "version": "0.2.1",
  "description": "amazon.co.jp の注文履歴から、月別の支出・注文内容・配達状況を表示します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.amazon.co.jp/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "注文履歴トラッカーを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": ""
}
